    "openai-flagship": { "match": ["^gpt-\\d", "^gpt-4"], "input": 2.5, "output": 10 },
    "anthropic-haiku": { "match": ["haiku"], "input": 1, "output": 5 },
    "anthropic-sonnet": { "match": ["sonnet"], "input": 3, "output": 15 },
    "anthropic-opus": { "match": ["opus"], "input": 15, "output": 75 },
    "qwen": { "match": ["qwen"], "input": 0.3, "output": 1.2 },
    "local": { "match": ["llama", "mistral", "gemma", "phi", "ollama"], "input": 0, "output": 0 },
    "generic": { "match": [], "input": 1, "output": 4 }
  }
